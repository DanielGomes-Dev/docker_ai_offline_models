# AI Inference — modelos locais (TTS + Whisper)
APP_AI_INFERENCE_HOST=0.0.0.0
APP_AI_INFERENCE_PORT=8005
APP_AI_INFERENCE_URL=http://ai-inference:8005

# Whisper
WHISPER_MODEL_SIZE=large-v3
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
WHISPER_DOWNLOAD_ROOT=/models/whisper

# TTS Gemini (opcional — só se trocar o provider no config.json p/ "gemini")
GOOGLE_API_KEY_00=
GOOGLE_API_KEY_01=
